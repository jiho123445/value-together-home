# ─────────────────────────────────────────────────────────────────────────
# 가치함께 홈페이지 환경변수
#
# 실제 값은 이 파일이 아니라 .env.local(로컬 개발) 및 Vercel 프로젝트의
# Environment Variables(배포)에 설정합니다. 이 파일(.env.example)은 어떤
# 값이 필요한지 알려주는 템플릿이며, 실제 비밀값을 절대 커밋하지 않습니다.
#
# 새 Firebase 프로젝트를 만든 뒤 "프로젝트 설정 > 일반 > 내 앱(웹)"에서
# 아래 값들을 그대로 복사해 오면 됩니다. 자세한 절차는 README.md의
# "Firebase 설정 방법"을 참고하세요.
# ─────────────────────────────────────────────────────────────────────────

# Firebase 프로젝트 설정 (Firebase Console > 프로젝트 설정 > 일반 > 웹 앱)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 기본 Firestore 데이터베이스를 사용하면 비워둡니다. 별도 명명 데이터베이스를
# 만든 경우에만 그 ID를 입력하세요.
VITE_FIREBASE_DATABASE_ID=

# 관리자 계정 (Firebase Authentication에 이메일/비밀번호 계정을 만든 뒤,
# 해당 계정의 UID와 이메일을 입력합니다. 절대 재단 홈페이지의 값을
# 재사용하지 마세요 — 반드시 가치함께 전용 신규 계정이어야 합니다.)
VITE_ADMIN_UID=
VITE_ADMIN_EMAIL=

# (선택) Google Analytics 4 측정 ID
VITE_GA_MEASUREMENT_ID=

# (선택, 권장) Firebase App Check — 봇/악용 방지용 reCAPTCHA v3 사이트 키.
# Firebase Console > App Check 에서 이 웹 앱을 reCAPTCHA v3로 등록하면
# 발급됩니다. 비워두면 App Check가 비활성화된 채로 기존처럼 동작합니다.
# 설정 절차는 README.md의 "App Check 설정 방법"을 참고하세요.
VITE_RECAPTCHA_V3_SITE_KEY=
