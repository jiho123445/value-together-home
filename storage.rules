rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ⚠️ firestore.rules와 동일한 UID로 맞춰주세요 (배포 전 필수 교체).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_NEW_ADMIN_UID';
    }

    // 활동갤러리 사진: 1개당 최대 10MiB, 이미지 형식만 허용.
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

    // 주요사업 이미지: 1개당 최대 10MiB.
    match /programs/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

    // 메인 팝업 이미지: 1개당 최대 5MiB.
    match /popups/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

    // 소식(공지/보도자료 등) 첨부파일: 1개당 최대 25MiB.
    // HWP/HWPX는 브라우저별로 MIME 표기가 달라 앱이 업로드 전에 표준
    // MIME 값으로 정규화하고, Storage Rules는 정규화된 MIME과 확장자를
    // 함께 검증합니다.
    match /notices/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/haansofthwp',
          'application/vnd.hancom.hwp',
          'application/x-hwp',
          'application/vnd.hancom.hwpx',
          'application/x-hwpx',
          'application/octet-stream',
          'application/zip',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'image/jpeg', 'image/png', 'image/webp', 'image/gif'
        ]
        && request.resource.name.matches('.*\\.(pdf|PDF|hwp|HWP|hwpx|HWPX|doc|DOC|docx|DOCX|xls|XLS|xlsx|XLSX|ppt|PPT|pptx|PPTX|jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP|gif|GIF)$');
      allow delete: if isAdmin();
    }

    // 기관 기본정보 이미지(대표 이미지, 로고, 대표자 사진 등): 1개당 최대 10MiB.
    match /settings/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

    // 협력기관 로고: 1개당 최대 5MiB.
    match /partners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

    // 그 외 모든 경로는 기본 차단.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
